# Frontend RPC override. If omitted, Shadow-Dex uses seismic-react's seismicTestnet config.
VITE_RPC_URL=

# Frontend contract addresses populated after deployment.
VITE_SHADOW_POOL_ADDRESS=
VITE_TOKEN0_ADDRESS=
VITE_TOKEN1_ADDRESS=

# Contract deployment (Codespaces/local only — never commit a real private key).
SEISMIC_RPC_URL=https://testnet-2.seismictest.net/rpc
PRIVATE_KEY=

# Optional deployment overrides.
INITIAL_SUPPLY=1000000000000000000000000
TOKEN0_NAME=Shadow USD
TOKEN0_SYMBOL=sUSD
TOKEN1_NAME=Shadow ETH
TOKEN1_SYMBOL=sETH
